# BugDrop - Development Environment Variables
# Copy this file to .dev.vars and fill in your values

# =============================================================================
# REQUIRED: ClickUp Credentials
# =============================================================================

# Step 1: Get a personal API token
#   - Log into ClickUp
#   - Click your avatar (bottom left) → Settings
#   - In the left sidebar, under "Integrations & ClickApps", click "ClickUp API"
#   - Click "Generate" (or "Regenerate" if one already exists)
#   - Copy the token — it starts with "pk_"
CLICKUP_API_TOKEN=pk_your_token_here

# Step 2: Get the destination List ID
#   - Open the ClickUp List where BugDrop tasks should be created
#   - The List ID is the numeric segment in the URL, e.g.
#     https://app.clickup.com/9012345/v/li/901234567 → List ID is 901234567
#   - Or right-click the List in the sidebar → "Copy link" and take the trailing ID
# Local development should override the committed wrangler.toml default here instead of editing wrangler.toml.
CLICKUP_LIST_ID=901234567

# =============================================================================
# OPTIONAL: Override wrangler.toml defaults for local development
# =============================================================================

# Allowed origins for CORS (comma-separated, or "*" for all)
# In production, set this to your actual domains
# ALLOWED_ORIGINS=https://mysite.com,https://staging.mysite.com

# Maximum screenshot size in MB
# MAX_SCREENSHOT_SIZE_MB=5

# Optional: where "/" redirects for self-hosted deployments.
# ROOT_REDIRECT_URL=https://example.com

# Optional: require short-lived host-app auth tokens before creating tasks.
# Use this for self-hosted widgets that should only accept feedback from authenticated users.
# AUTH_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
# AUTH_TOKEN_AUDIENCE=bugdrop.your-subdomain.workers.dev
# AUTH_TOKEN_ISSUER=app.yourdomain.com
# AUTH_TOKEN_REQUIRED_FOR_CHECK=true

# RATE_LIMIT is intentionally not configured here.
# Local development runs with ENVIRONMENT=development and can work without a KV namespace.
